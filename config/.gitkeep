# ملف .gitignore - حماية الملفات الحساسة من النشر

# ملفات الإعدادات الحساسة
config/admin-config.js
config/*.env
config/secrets.js

# ملفات البيئة
.env
.env.local
.env.development
.env.test
.env.production

# مجلدات النظام
.DS_Store
Thumbs.db

# ملفات المحررات
.vscode/
.idea/
*.swp
*.swo

# ملفات مؤقتة
*.tmp
*.temp
*.log

# ملفات النسخ الاحتياطية
*.bak
*.backup

# مجلد التحميلات (إذا كان يحتوي ملفات حساسة)
downloads/private/

# ملاحظات شخصية
notes.txt
todo.txt
private.md

# مفاتيح API (إضافي للحماية)
*api-key*
*secret*
*private-key*

# ملفات قواعد البيانات المحلية (إذا وجدت)
*.db
*.sqlite

# فقط في حالة إضافة Node.js لاحقاً
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# تقارير التحليل
coverage/
*.coverage